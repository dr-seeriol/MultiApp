<Window x:Class="MultiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MultiApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width= "2*"/>
            <ColumnDefinition Width= "*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />


        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Label Grid.Row="0" Grid.Column="0" Content="Name:" VerticalAlignment="Center" HorizontalAlignment="Center" />
            <Label x:Name="NameValueLabel" Content="Evil Wizard" Grid.Row="1" Grid.Column="0"
       VerticalAlignment="Center" HorizontalAlignment="Center" />


        </StackPanel>
        <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Label Grid.Row="0" Grid.Column="1" Content="Age:" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
            <Label x:Name="AgeValueLabel" Content="700" Grid.Row="1" Grid.Column="1"
                VerticalAlignment="Top" HorizontalAlignment="Center" Width="40" />


        </StackPanel>

        <CheckBox Grid.Column="2" Content="Adult" HorizontalAlignment="Center"  Grid.Row="0" VerticalAlignment="Center"/>
        <Button Grid.ColumnSpan="3" HorizontalAlignment="Center"  Grid.Row="1" VerticalAlignment="Center" IsDefault="True" Click="EditButton">
            <StackPanel Orientation="Horizontal" Height="68" Width="102">
                <Image Source="/Images/pencil-png-653.png" Height="52" Width="57"/>
                <Label Content="Edit" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </Button>

    </Grid>
</Window>
